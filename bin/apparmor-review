#!/bin/bash
# AppArmor observation review helper - created 2026-08-05.
# Run it any time (it also pops a desktop notification):
#   ~/bin/apparmor-review
#
# When the ~1-week observation window ends (reminder fires 2026-08-12):
#   1. Build allow-lists from real usage:
#        sudo aa-logprof
#      (no per-profile flag exists — aa-logprof walks every profile in the
#       audit log; answer the sublime_text questions, (S)kip the rest)
#   2. Enforce ONLY what has a real profile:
#        sudo aa-enforce /etc/apparmor.d/sublime-text
#      helium-bin: LEAVE IN COMPLAIN. The shipped stub profile
#      (flags=(default_allow) + userns) breaks Helium when enforced
#      (proven 2026-08-31: browser refused to launch). It needs a real
#      profile written from aa-logprof output before enforcement.
#   3. Shrink the audit log cap back to normal:
#        sudo sed -i 's/^max_log_file = .*/max_log_file = 8/' /etc/audit/auditd.conf
#        sudo systemctl restart auditd
#   4. Silence this timer:
#        systemctl --user disable --now apparmor-review-reminder.timer

set -u

in_complain() {
  sudo aa-status 2>/dev/null \
    | sed -n '/profiles are in complain/,/processes are in complain/p' \
    | grep -qw "$1"
}

events() {
  sudo ausearch -m AVC --start week --raw 2>/dev/null | grep -c "profile=\"$1\""
}

summary=""
for p in helium-bin sublime_text; do
  if in_complain "$p"; then mode="complain (still observing)"; else mode="not in complain (enforced or off)"; fi
  n=$(events "$p")
  summary+="$p: $mode - $n audit events this week
"
done

echo "$summary"

notify-send -i dialog-information "AppArmor review due" "$summary
Review: sudo aa-logprof (no per-profile flag; (S)kip what you don't want).
Enforce sublime-text only; helium-bin stays in complain (stub breaks Helium).
Full instructions: ~/bin/apparmor-review" 2>/dev/null || true
