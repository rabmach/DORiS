#!/usr/bin/env bash
# 2026 machiner opencode
### part of the DORiS suite of goodness - debian openbox restoration script(s) - 2026
### setup-printer -> ~/bin/setup-printer
###
### Find a networked printer on the LAN and install it as a CUPS queue.
### Works for any mDNS/Bonjour-advertising printer (HP, Brother, Epson, ...).
### Idempotent: if a queue already exists for the discovered printer, it just
### prints its info and exits 0.
###
### Usage:
###     setup-printer                      # auto-discover via avahi, name from hostname
###     setup-printer -i 192.168.1.110     # skip discovery, use explicit IP
###     setup-printer -q hp                # name the queue (default: hostname-based)
###     setup-printer -n                   # don't print a test page
###
### The firewall must allow mDNS out to 224.0.0.251/ff02::fb (doris hardening
### ships these rules) or discovery finds nothing and you use -i.

if [[ "$(id -u)" != "0" ]]; then
  exec sudo "$(readlink -f "$0")" "$@"
fi

QUEUE=""
EXPLICIT_IP=""
TESTPAGE=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    -i) EXPLICIT_IP="$2"; shift 2 ;;
    -q) QUEUE="$2"; shift 2 ;;
    -n) TESTPAGE=0; shift ;;
    -h|--help)
      sed -n 's/^### \{0,1\}//p' "$0"
      exit 0
      ;;
    *) echo "setup-printer: unknown option '$1' (try -h)" >&2; exit 1 ;;
  esac
done

if ! command -v lpadmin >/dev/null || ! command -v lpstat >/dev/null; then
  echo "setup-printer: CUPS client tools not installed (install cups)." >&2
  exit 1
fi

NAME=""
IP=""

# ── 1. discovery ────────────────────────────────────────────────
if [[ -n "$EXPLICIT_IP" ]]; then
  IP="$EXPLICIT_IP"
  NAME="printer"
else
  if ! command -v avahi-browse >/dev/null; then
    echo "setup-printer: avahi-browse not found - pass -i <ip> instead." >&2
    exit 1
  fi
  SERVICE=$(timeout 8 avahi-browse -rt _ipp._tcp 2>/dev/null)
  [[ -z "$SERVICE" ]] && SERVICE=$(timeout 8 avahi-browse -rt _printer._tcp 2>/dev/null)
  IP=$(sed -n 's/.*address = \[\([0-9.]*\)\].*/\1/p' <<<"$SERVICE" | head -1)
  HOST=$(sed -n 's/.*hostname = \[\([^]]*\)\].*/\1/p' <<<"$SERVICE" | head -1)
  if [[ -z "$IP" && -n "$HOST" ]]; then
    IP=$(timeout 4 avahi-resolve -n "$HOST" 2>/dev/null | awk '{print $2}')
  fi
  NAME=${HOST%.local}
  NAME=$(printf '%s' "$NAME" | tr -cd '[:alnum:]')
  [[ -z "$NAME" ]] && NAME="printer"
fi

if [[ -z "$IP" ]]; then
  echo "setup-printer: no printer found via mDNS (avahi)." >&2
  echo "  Power it on, check the firewall (mDNS UDP 5353 out to multicast), or use -i <ip>." >&2
  exit 1
fi

# ── 2. idempotency: reuse an existing queue for this IP ──────────
EXISTING=$(lpstat -v 2>/dev/null | grep "$IP" | head -1)
if [[ -n "$EXISTING" ]]; then
  echo "setup-printer: printer already installed:"
  echo "  $EXISTING"
  exit 0
fi

# ── 3. install driverless IPP queue ─────────────────────────────
[[ -z "$QUEUE" ]] && QUEUE=$(printf '%s' "$NAME" | tr 'A-Z' 'a-z')
if lpstat -p "$QUEUE" >/dev/null 2>&1; then
  echo "setup-printer: queue '$QUEUE' already exists - leaving it alone."
  exit 0
fi

URI="ipp://$IP:631/ipp/print"
echo "setup-printer: installing '$QUEUE' -> $URI (driverless IPP Everywhere)..."
if ! lpadmin -p "$QUEUE" -E -v "$URI" -m everywhere 2>/dev/null; then
  URI="ipp://$IP:631"
  lpadmin -p "$QUEUE" -E -v "$URI" -m everywhere || {
    echo "setup-printer: lpadmin failed for $URI - check printer reachability." >&2
    exit 1
  }
fi
lpadmin -d "$QUEUE" 2>/dev/null

echo "  queue:    $QUEUE"
echo "  device:   $URI"
echo "  host:     $NAME ($IP)"
echo "  default:  $(lpstat -d 2>/dev/null | sed 's/.*: //')"

# ── 4. test page ────────────────────────────────────────────────
if [[ "$TESTPAGE" == "1" ]]; then
  printf 'DORiS printer test\nprinter: %s (%s)\ntime: %s\n' "$QUEUE" "$IP" "$(date)" \
    | lp -d "$QUEUE" - >/dev/null 2>&1 \
    && echo "  test page sent."
fi
