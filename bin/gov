#!/bin/sh
# Toggle CPU governor across all cores. Usage: gov [performance|powersave]
#  no args  -> powersave; 's'  -> powersave (same as default); 'p'  -> performance
target="${1:-powersave}"
case "$target" in
  s|save) target=powersave ;;
  p|perf) target=performance ;;
  performance|powersave) ;;
  *) echo "usage: gov [performance|powersave]" >&2; exit 1 ;;
esac
if [ "$(id -u)" -ne 0 ]; then
  exec sudo "$(readlink -f "$0")" "$target"
fi
for g in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_governor; do
  echo "$target" > "$g"
done
echo "governor now: $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor)"
