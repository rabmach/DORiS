{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 1,
            "right": 2
        }
    },

    "modules": [
        {
            "format": "{#keys}\u001b[76D           💻         : {user-name-colored}{at-symbol-colored}{host-name-colored}",
            "type": "title"
        },
        {
            "key": "{#31} kernel   ",
            "type": "kernel"
        },
        {
            "key": "{#32}󰅐 uptime   ",
            "type": "uptime"
        },
        {
            "key": "{#33}{icon} distro   ",
            "type": "os"
        },
        {
            "key": "{#34}󰇄 desktop  ",
            "type": "de"
        },
        {
            "key": "{#35} term     ",
            "type": "terminal"
        },
        {
            "key": "{#36} shell    ",
            "type": "shell"
        },
        {
            "key": "{#35}󰍛 cpu      ",
            "type": "cpu",
            "showPeCoreCount": true,
            "temp": true
        },
        {
            "key": "{#34}󰍛 gpu      ",
            "type": "gpu"
        },
        {
            "key": "{#33}󰉉 disk     ",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "{#32} memory   ",
            "type": "memory"
        },
        {
            "key": "{#31}󰩟 network  ",
            "type": "localip",
            "format": "{ipv4} ({ifname})"
        },
           {
             "key": "{#33} Sound    ",
            "type": "sound",
         },
        {
             "key": "{#33}󰥠          ",
            "type": "player",
           
            
        },
        {
             "key": "{#31}󰝚          ",
            "type": "media",
           
        }

    ]
}
